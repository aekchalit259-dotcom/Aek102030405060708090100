b:Button("วิ่งเร็วและแสดงตำแหน่งสีแดง (10 วินาที)", function()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    -- บันทึกค่าความเร็วเดิม
    local originalSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = originalSpeed * 2
    
    -- สร้าง Highlight แสดงตำแหน่งสีแดง
    local highlight = Instance.new("Highlight")
    highlight.Name = "SpeedHighlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = character
    
    -- หน่วงเวลา 10 วินาที แล้วคืนค่าเดิม
    task.delay(10, function()
        if humanoid and humanoid.Parent then
            humanoid.WalkSpeed = originalSpeed
        end
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end)
end)
